# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env)
# 1) Copia este archivo como ".env"  (cp .env.ejemplo .env)
# 2) Llena tus valores reales
# 3) NUNCA subas el .env a Git (ya está en el .gitignore)
# El setup_vps.sh reemplaza SECRET_KEY con uno aleatorio automático.
# Guía: docs/08-app-flask-en-docker.md y docs/13-checklist-produccion.md
# ==============================================================================

# 1 en desarrollo, 0 en producción (¡NUNCA 1 en el VPS!)
DEBUG=0

# Clave secreta de Flask: firma cookies y tokens.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZA_CON_UNA_CLAVE_ALEATORIA_LARGA

# Nombre de la app (aparece en el /api/health)
APP_NAME=mi-app

# En producción, solo estos dominios pueden usar la API
# (tu dominio + el de Vercel si tienes frontend)
ALLOWED_HOSTS=mi-app.duckdns.org
CORS_ORIGINS=https://mi-app-web.vercel.app

# Base de datos (solo si agregaste el servicio db en docker-compose)
POSTGRES_USER=miapp
POSTGRES_PASSWORD=REEMPLAZA_CON_OTRA_CLAVE_ALEATORIA
POSTGRES_DB=miapp
